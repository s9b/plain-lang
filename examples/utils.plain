# utils.plain — reusable helper functions for examples

fn double n
    return n * 2
end

fn triple n
    return n * 3
end

fn greet name
    say "Hello, " + name + "!"
end

fn clamp val lo hi
    if val < lo then
        return lo
    else
        if val > hi then
            return hi
        else
            return val
        end
    end
end
